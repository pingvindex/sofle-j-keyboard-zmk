#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>

// #include <dt-bindings/zmk/pointing.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#undef ZMK_MOUSE_DEFAULT_MOVE_VAL
#undef ZMK_MOUSE_DEFAULT_SCRL_VAL

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 300
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 25    // 5

/ {
    behaviors {
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-while-undecided;
        };

        // Timeless Home Row Mods - Left hand
        // Triggers on: right side keys + same-hand mod keys (for GUI+ALT combos etc.)
        // Sofle matrix (14 cols, col 6 = encoder gap):
        //   left half  cols 0-5  -> positions 0-5,13-18,26-31,39-44,52-57
        //   right half cols 7-13 -> positions 6-12,19-25,32-38,45-51,58-63
        //   left home-row mods: S(28) D(29) F(30); left shifts: 26, 57
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 12 19 20 21 22 23 24 25 26 28 29 30 32 33 34 35 36 37 38 45 46 47 48 49 50 51 57 58 59 60 61 62 63>;
        };

        // Timeless Home Row Mods - Right hand
        // Triggers on: left side keys + same-hand mod keys (for GUI+ALT combos etc.)
        //   right home-row mods: J(34) K(35) L(36); right shift: 59
        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 34 35 36 39 40 41 42 43 44 52 53 54 55 56 57 59>;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            label = "LTH";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            hold-while-undecided;
        };

        mmv {
            acceleration-exponent = <6>;      // 1
            time-to-max-speed-ms = <40>;    // 40
            delay-ms = <1>;                   // 0
        };

        msc {
            acceleration-exponent = <2>;      // 0.5 (adjust to your preference)
            time-to-max-speed-ms = <100>;     // 500 (adjust to your preference)
            delay-ms = <2>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE            &kp N1    &kp N2     &kp N3    &kp N4     &kp N5             &kp UP_ARROW     &kp N6               &kp N7       &kp N8     &kp N9     &kp N0         &kp MINUS
&kp ESCAPE           &kp Q     &kp W      &kp E     &kp R      &kp T              &kp DOWN_ARROW   &kp Y                &kp U        &kp I      &kp O      &kp P          &kp BACKSLASH
&mt LSHFT BACKSPACE  &kp A  &hm_l LCTRL S  &hm_l LALT D  &hm_l LGUI F  &kp G  &kp LEFT_ARROW  &kp H  &hm_r RGUI J  &hm_r RALT K  &hm_r RCTRL L  &kp SEMICOLON  &kp APOS
&kp ENTER            &kp Z     &kp X      &kp C     &kp V      &kp B              &kp RIGHT_ARROW  &kp N                &kp M        &kp COMMA  &kp DOT    &kp FSLH       &kp EQUAL
&kp C_MUTE           &kp LALT  &kp LCTRL  &kp LGUI  &lt 2 TAB  &mt LSHFT SPACE    &kp LS(ENTER)    &mt RSHFT BACKSPACE  &lt 1 ENTER  &kp RCMD   &kp RCTRL  &mt RALT CAPS
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&none          &none     &none      &none      &none      &none     &kp UP_ARROW     &none      &none       &none           &none              &none      &none
&kp GRAVE      &kp N1    &kp N2     &kp N3     &kp N4     &kp N5    &kp DOWN_ARROW   &kp EXCL   &kp AT      &kp LBKT        &kp RIGHT_BRACKET  &kp PRCNT  &none
&kp BACKSPACE  &kp N6    &kp N7     &kp N8     &kp N9     &kp N0    &kp LEFT_ARROW   &kp CARET  &kp AMPS    &kp LPAR        &kp RPAR           &kp STAR   &none
&none          &kp PLUS  &kp EQUAL  &kp MINUS  &kp UNDER  &none     &kp RIGHT_ARROW  &kp HASH   &kp DOLLAR  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp FSLH   &none
&kp C_MUTE     &trans    &trans     &trans     &trans     &trans    &kp LS(ENTER)    &trans     &none       &trans          &trans             &trans
            >;

            display-name = "LOWER";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&none       &none         &none        &none         &mkp RCLK    &mkp LCLK         &mmv MOVE_UP     &none      &none     &none     &none            &none   &none
&kp TAB     &kp F1        &kp F2       &kp F3        &kp F4       &msc SCRL_UP      &mmv MOVE_DOWN   &kp PG_UP  &kp HOME  &kp UP    &kp END          &none   &none
&none       &hm LSHFT F5  &hm LALT F6  &hm LCTRL F7  &hm LCMD F8  &msc SCRL_DOWN    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT_ARROW  &none   &none
&kp ESCAPE  &kp F9        &kp F10      &kp F11       &kp F12      &none             &mmv MOVE_RIGHT  &none      &none     &none     &none            &none   &none
&to 3       &trans        &trans       &trans        &trans       &trans            &mkp LCLK        &trans     &none     &trans    &trans           &trans
            >;

            display-name = "RAISE";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&none            &none            &none           &none            &none            &none              &kp UP         &none           &none            &none              &none            &none          &none
&sys_reset       &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &kp DOWN       &msc SCRL_UP    &mkp MB1         &mmv MOVE_UP       &mkp MB2         &kp C_BRI_UP   &none
&rgb_ug RGB_BRI  &bt BT_CLR       &bt BT_CLR_ALL  &out OUT_USB     &out OUT_BLE     &bootloader        &kp LEFT       &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &kp C_BRI_DEC  &sys_reset
&rgb_ug RGB_BRD  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &kp RIGHT      &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE     &bootloader
&kp C_MUTE       &none            &mkp MB3        &mkp MB2         &to 0            &mkp MB1           &kp LS(ENTER)  &none           &to 0            &none              &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };
    };
};
