#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>

// #include <dt-bindings/zmk/pointing.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#undef ZMK_MOUSE_DEFAULT_MOVE_VAL
#undef ZMK_MOUSE_DEFAULT_SCRL_VAL

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 300
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 25    // 5

/ {
    behaviors {
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-while-undecided;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            label = "LTH";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            hold-while-undecided;
        };

        mmv {
            acceleration-exponent = <6>;      // 1
            time-to-max-speed-ms = <40>;    // 40
            delay-ms = <1>;                   // 0
        };

        msc {
            acceleration-exponent = <2>;      // 0.5 (adjust to your preference)
            time-to-max-speed-ms = <100>;     // 500 (adjust to your preference)
            delay-ms = <2>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE            &kp N1    &kp N2     &kp N3    &kp N4     &kp N5             &kp UP_ARROW     &kp N6               &kp N7       &kp N8     &kp N9     &kp N0         &kp MINUS
&kp ESCAPE           &kp Q     &kp W      &kp E     &kp R      &kp T              &kp DOWN_ARROW   &kp Y                &kp U        &kp I      &kp O      &kp P          &kp BACKSLASH
&mt LSHFT BACKSPACE  &kp A     &kp S      &kp D     &kp F      &kp G              &kp LEFT_ARROW   &kp H                &kp J        &kp K      &kp L      &kp SEMICOLON  &kp APOS
&kp ENTER            &kp Z     &kp X      &kp C     &kp V      &kp B              &kp RIGHT_ARROW  &kp N                &kp M        &kp COMMA  &kp DOT    &kp FSLH       &kp EQUAL
&kp C_MUTE           &kp LALT  &kp LCTRL  &kp LGUI  &lt 2 TAB  &mt LSHFT SPACE    &kp LS(ENTER)    &mt RSHFT BACKSPACE  &lt 1 ENTER  &kp RCMD   &kp RCTRL  &mt RALT CAPS
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&none          &none         &none         &none         &none         &none           &kp UP_ARROW     &none      &none       &none           &none              &none      &none
&kp GRAVE      &kp N1        &kp N2        &kp N3        &kp NUMBER_4  &kp N5          &kp DOWN_ARROW   &kp EXCL   &kp AT      &kp LBKT        &kp RIGHT_BRACKET  &kp PRCNT  &none
&kp BACKSPACE  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &kp LEFT_ARROW   &kp CARET  &kp AMPS    &kp LPAR        &kp RPAR           &kp STAR   &none
&none          &kp PLUS      &kp EQUAL     &kp MINUS     &kp UNDER     &kp ENTER       &kp RIGHT_ARROW  &kp HASH   &kp DOLLAR  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp FSLH   &none
&kp C_MUTE     &trans        &trans        &trans        &kp TAB       &trans          &kp LS(ENTER)    &trans     &none       &trans          &trans             &trans
            >;

            display-name = "LOWER";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&none       &none         &none        &none         &none        &none     &mmv MOVE_UP     &none      &none      &none     &none            &none   &none
&kp TAB     &kp F1        &kp F2       &kp F3        &kp F4       &none     &mmv MOVE_DOWN   &kp PG_UP  &kp HOME   &kp UP    &kp END          &none   &none
&none       &hm LSHFT F5  &hm LALT F6  &hm LCTRL F7  &hm LCMD F8  &none     &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT   &kp DOWN  &kp RIGHT_ARROW  &none   &none
&kp ESCAPE  &kp F9        &kp F10      &kp F11       &kp F12      &none     &mmv MOVE_RIGHT  &none      &none      &none     &none            &none   &none
&to 3       &trans        &trans       &trans        &trans       &trans    &mkp LCLK        &trans     &kp ENTER  &trans    &trans           &trans
            >;

            display-name = "RAISE";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&none            &none            &none           &none            &none            &none              &kp UP         &none           &none            &none              &none            &none          &none
&sys_reset       &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &kp DOWN       &msc SCRL_UP    &mkp MB1         &mmv MOVE_UP       &mkp MB2         &kp C_BRI_UP   &none
&rgb_ug RGB_BRI  &bt BT_CLR       &bt BT_CLR_ALL  &out OUT_USB     &out OUT_BLE     &bootloader        &kp LEFT       &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &kp C_BRI_DEC  &sys_reset
&rgb_ug RGB_BRD  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &kp RIGHT      &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE     &bootloader
&kp C_MUTE       &none            &mkp MB3        &mkp MB2         &to 0            &mkp MB1           &kp LS(ENTER)  &none           &to 0            &none              &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };
    };
};
