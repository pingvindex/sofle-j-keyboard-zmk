#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>

// #include <dt-bindings/zmk/pointing.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#undef ZMK_MOUSE_DEFAULT_MOVE_VAL
#undef ZMK_MOUSE_DEFAULT_SCRL_VAL

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 300
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 25    // 5

/ {
    behaviors {
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-while-undecided;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            label = "LTH";
            bindings = <&to>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            hold-while-undecided;
        };

        mmv {
            acceleration-exponent = <6>;      // 1
            time-to-max-speed-ms = <40>;    // 40
            delay-ms = <1>;                   // 0
        };

        msc {
            acceleration-exponent = <2>;      // 0.5 (adjust to your preference)
            time-to-max-speed-ms = <100>;     // 500 (adjust to your preference)
            delay-ms = <2>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp CAPS        &kp N1    &kp N2     &kp N3    &kp N4        &kp N5                &kp UP_ARROW     &kp N6               &kp N7    &kp N8     &kp N9     &kp N0    &none
&kp ESCAPE      &kp Q     &kp W      &kp E     &kp R         &kp T                 &kp DOWN_ARROW   &kp Y                &kp U     &kp I      &kp O      &kp P     &kp LEFT_BRACKET
&kp TAB         &kp A     &kp S      &kp D     &kp F         &kp G                 &kp LEFT_ARROW   &kp H                &kp J     &kp K      &kp L      &kp SEMI  &kp APOS
&kp LEFT_SHIFT  &kp Z     &kp X      &kp C     &kp V         &kp B                 &kp RIGHT_ARROW  &kp N                &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RIGHT_BRACKET
&kp C_MUTE      &kp LALT  &kp LCTRL  &kp LGUI  &ltq 1 SPACE  &hm LEFT_GUI ENTER    &kp LS(ENTER)    &hm LCTRL BACKSPACE  &lth 1 1  &kp RGUI   &kp RCTRL  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&none       &none     &none      &none     &none      &none             &kp UP_ARROW     &none          &none       &none           &none              &none      &none
&kp GRAVE   &kp N1    &kp N2     &kp N3    &kp PLUS   &kp EQUAL         &kp DOWN_ARROW   &kp EXCL       &kp AT      &kp LBKT        &kp RIGHT_BRACKET  &kp PRCNT  &kp BSLH
&kp TILDE   &kp N4    &kp N5     &kp N6    &kp MINUS  &kp UNDERSCORE    &kp LEFT_ARROW   &kp CARET      &kp AMPS    &kp LPAR        &kp RPAR           &kp STAR   &kp PIPE
&kp LSHFT   &kp N7    &kp N8     &kp N9    &kp N0     &kp MINUS         &kp RIGHT_ARROW  &kp HASH       &kp DOLLAR  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp FSLH   &kp RSHFT
&kp C_MUTE  &kp LALT  &kp LCTRL  &kp LGUI  &tog 0     &kp ENTER         &kp LS(ENTER)    &kp BACKSPACE  &tog 2      &kp RGUI        &kp RCTRL          &kp RALT
            >;

            display-name = "LOWER";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&none      &none     &none      &none     &none    &none        &mmv MOVE_UP     &none      &none     &none     &none            &none     &none
&kp ESC    &kp F1    &kp F2     &kp F3    &kp F4   &none        &mmv MOVE_DOWN   &kp PG_UP  &kp HOME  &kp UP    &kp END          &none     &none
&kp TAB    &kp F5    &kp F6     &kp F7    &kp F8   &none        &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT_ARROW  &none     &none
&kp LSHFT  &kp F9    &kp F10    &kp F11   &kp F12  &none        &mmv MOVE_RIGHT  &none      &none     &none     &none            &none     &kp RSHFT
&tog 3     &kp LALT  &kp LCTRL  &kp LGUI  &tog 0   &kp ENTER    &mkp LCLK        &kp BSPC   &tog 2    &kp RGUI  &kp RCTRL        &kp RALT
            >;

            display-name = "RAISE";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&none            &none            &none           &none            &none            &none              &kp UP         &none           &none            &none              &none            &none          &none
&sys_reset       &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &kp DOWN       &msc SCRL_UP    &mkp MB1         &mmv MOVE_UP       &mkp MB2         &kp C_BRI_UP   &none
&rgb_ug RGB_BRI  &bt BT_CLR       &bt BT_CLR_ALL  &out OUT_USB     &out OUT_BLE     &bootloader        &kp LEFT       &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &kp C_BRI_DEC  &sys_reset
&rgb_ug RGB_BRD  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &kp RIGHT      &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE     &bootloader
&kp C_MUTE       &none            &mkp MB3        &mkp MB2         &tog 0           &mkp MB1           &kp LS(ENTER)  &none           &tog 2           &none              &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };
    };
};
