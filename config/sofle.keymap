// NOTE: must be defined BEFORE <dt-bindings/zmk/mouse.h> is included,
// otherwise the header's #ifndef defaults win and cpp emits -Wmacro-redefined.
// (On modern ZMK these are ZMK_POINTING_DEFAULT_MOVE_VAL / _SCRL_VAL.)

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1600  // default: 600  -> max cursor velocity
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // default: 10   -> max scroll velocity

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        // Cursor speed. velocity(t) = max * (t / time-to-max-speed-ms)^acceleration-exponent
        // so a big time-to-max-speed-ms makes short presses crawl.

        mmv {
            acceleration-exponent = <1>;      // 1 = linear ramp; raise for fine control at low speed
            time-to-max-speed-ms = <100>;     // was 900 (ZMK default: 300)
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <100>;     // was 1200 (ZMK default: 300)
            delay-ms = <0>;                   // 0
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE       &kp N1     &kp N2        &kp N3    &kp N4  &kp N5       &kp UP_ARROW     &kp N6         &kp N7  &kp N8        &kp N9    &kp N0     &kp MINUS
&kp TAB         &kp Q      &kp W         &kp E     &kp R   &kp T        &kp DOWN_ARROW   &kp Y          &kp U   &kp I         &kp O     &kp P      &kp ENTER
&mt LSHFT CAPS  &kp A      &kp S         &kp D     &kp F   &kp G        &kp LEFT_ARROW   &kp H          &kp J   &kp K         &kp L     &kp SEMI   &kp APOS
&kp ESC         &kp Z      &kp X         &kp C     &kp V   &kp B        &kp RIGHT_ARROW  &kp N          &kp M   &kp COMMA     &kp DOT   &kp FSLH   &mt RSHFT CAPS
&kp C_MUTE      &kp LCTRL  &kp LEFT_ALT  &kp LGUI  &mo 2   &kp SPACE    &to 3            &kp BACKSPACE  &mo 1   &mt RGUI RET  &kp RALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&kp F1      &kp F2    &kp F3     &kp F4     &kp F5     &kp F6       &kp UP     &kp F7     &kp F8     &kp F9    &kp F10   &kp F11   &kp F12
&kp TAB     &kp N1    &kp N2     &kp N3     &kp N4     &kp N5       &kp DOWN   &kp EXCL   &kp QMARK  &kp LBKT  &kp RBKT  &kp AT    &kp PIPE
&kp BSPC    &kp N6    &kp N7     &kp N8     &kp N9     &kp N0       &kp LEFT   &kp CARET  &kp AMPS   &kp LPAR  &kp RPAR  &kp HASH  &kp BSLH
&kp RET     &kp PLUS  &kp EQUAL  &kp MINUS  &kp UNDER  &kp TILDE    &kp RIGHT  &kp PRCNT  &kp STAR   &kp LBRC  &kp RBRC  &kp DLLR  &kp FSLH
&kp C_MUTE  &kp SEMI  &kp LT     &kp GT     &kp COLON  &kp SPACE    &none      &none      &none      &none     &none     &none
            >;

            label = "RAISE";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&none  &none      &none      &none      &none      &none       &mmv MOVE_UP     &none     &none         &none     &none          &none  &none
&none  &none      &mkp MCLK  &mkp RCLK  &mkp LCLK  &mkp MB4    &mmv MOVE_DOWN   &kp HOME  &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &none  &none
&none  &kp LSHFT  &kp LCTRL  &kp LALT   &kp LCMD   &mkp MB5    &mmv MOVE_LEFT   &kp END   &kp LEFT      &kp DOWN  &kp RIGHT      &none  &none
&none  &none      &none      &none      &kp BSPC   &kp RET     &mmv MOVE_RIGHT  &none     &none         &none     &none          &none  &none
&none  &none      &none      &none      &none      &none       &mkp LCLK        &none     &none         &none     &none          &none
            >;

            display-name = "LOWER";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&bootloader  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &mmv MOVE_UP     &none           &none            &none           &none            &none  &bootloader
&sys_reset   &bt BT_CLR       &bt BT_CLR_ALL   &none            &rgb_ug RGB_HUD  &rgb_ug RGB_HUI    &mmv MOVE_DOWN   &msc SCRL_UP    &mkp LCLK        &mmv MOVE_UP    &mkp RCLK        &none  &sys_reset
&soft_off    &out OUT_USB     &out OUT_BLE     &none            &rgb_ug RGB_SAD  &rgb_ug RGB_SAI    &mmv MOVE_LEFT   &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &soft_off
&none        &rgb_ug RGB_TOG  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI    &mmv MOVE_RIGHT  &msc SCRL_LEFT  &msc SCRL_RIGHT  &none           &none            &none  &none
&none        &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &mkp MCLK        &mkp RCLK        &mkp LCLK          &to 0            &none           &to 0            &none           &none            &none
            >;

            display-name = "SYS";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
